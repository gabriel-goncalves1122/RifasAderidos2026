rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // 1. USUÁRIOS
    // ========================================================================
    match /usuarios/{documentId} {
      // =====================================================================
      // REGRA DEV (ativa)
      // Qualquer autenticado pode ler usuarios.
      // =====================================================================
      // allow read: if request.auth != null;

      // =====================================================================
      // REGRA PROD (comente a de cima e descomente esta antes do deploy)
      // Pré-requisito: rodar `npm run backfill:claims` para backfill
      //                de usuarios existentes.
      // A regra usa request.auth.token.cargo que é definido via
      // admin.auth().setCustomUserClaims() em:
      //   - authService.completarRegisto() (vinculo uid)
      //   - secretariaService.atualizarAderido() (alteracao de cargo)
      //   - authTriggers.onCreateUserSetClaims (novo cadastro Auth)
      // =====================================================================
      allow read: if request.auth != null && (
        request.auth.uid == documentId
        || ("email" in request.auth.token && resource != null && request.auth.token.email == resource.data.email)
        || request.auth.token.cargo in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria", "secretaria"
        ]
      );
      
      // Escrita totalmente bloqueada. Nenhuma atualização é permitida pelo frontend!
      // Apenas a API com Admin SDK pode alterar o documento.
      allow create, delete, update: if false;
    }

    // ========================================================================
    // 2. BILHETES (A Grelha de Rifas)
    // ========================================================================
    match /bilhetes/{document=**} {
      // PERMISSÃO DE LEITURA: Essencial para o RifaGrid conseguir mostrar os quadradinhos!
      allow read: if request.auth != null; 
      
      // BLOQUEIO DE ESCRITA: Ninguém compra rifas pelo frontend direto. Tudo passa pela sua API Node.js!
      allow write: if false; 
    }

    // ========================================================================
    // 3. PRÊMIOS E CONFIGURAÇÕES
    // ========================================================================
    match /premios/{document=**} {
      // O aderido precisa ler os prêmios para a aba "Prêmios"
      allow read: if request.auth != null;
      allow write: if false; 
    }
    
    match /configuracoes/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    // ========================================================================
    // 4. NOTIFICAÇÕES (O Sininho)
    // ========================================================================
    match /notificacoes/{notificacaoId} {
      // Lê apenas as suas próprias notificações
      allow read: if request.auth != null && resource.data.vendedor_id == request.auth.uid;
      
      // Permite atualizar APENAS para marcar como lida
      allow update: if request.auth != null 
                    && resource.data.vendedor_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
                    
      allow create, delete: if false;
    }

    // ========================================================================
    // 5. BLOQUEIO GERAL (Segurança Máxima)
    // ========================================================================
    // Qualquer outra coleção não especificada acima (ex: compradores, logs, etc) fica 100% trancada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}